# ==============================================================================
# KONFIGURASI ENVIRONMENT KASIR UMKM (SUPABASE + ANDROID APK)
# Salin file ini menjadi ".env" di root proyek (jangan commit ".env" ke Git).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. KONFIGURASI SUPABASE (WAJIB UNTUK WEB & BUILD APK RELEASE)
# ------------------------------------------------------------------------------
# Catatan Arsitektur:
# Aplikasi menggunakan @supabase/supabase-js secara langsung untuk:
# - Google OAuth (Web redirect & Android deep link com.aistudio.kasirumkm.qzvtmk://login-callback)
# - Autentikasi Email & Kata Sandi
# - Database PostgreSQL (10 tabel berelasi dengan UUID + Row Level Security)
# Karena itu VITE_API_BASE_URL TIDAK lagi dibutuhkan dan tidak ada URL localhost pada APK.
#
# Cara mengambil kunci di Supabase Dashboard:
# 1. Buka https://supabase.com/dashboard -> pilih proyek Anda
# 2. Masuk ke menu Project Settings (ikon roda gigi) -> Data API / API
# 3. Salin "Project URL" ke VITE_SUPABASE_URL (contoh: https://abcdefghijk.supabase.co)
# 4. Salin "anon / public" key (atau "Publishable key") ke VITE_SUPABASE_ANON_KEY
#    PERINGATAN KEAMANAN: JANGAN PERNAH menaruh service_role key di frontend (.env VITE_*)!
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# 2. PROXY MIDTRANS DINAMIS (OPSIONAL)
# ------------------------------------------------------------------------------
# Hanya diisi jika Anda mengaktifkan endpoint server.ts / Midtrans dynamic QRIS & VA.
# Untuk APK Release Android, wajib isi URL HTTPS publik server backend (JANGAN localhost!).
# Biarkan kosong jika tidak memakai Midtrans dinamis.
VITE_MIDTRANS_PROXY_URL=

# Set "true" untuk Midtrans Production, atau "false" untuk Sandbox (server-side only)
MIDTRANS_IS_PRODUCTION=false

# Server Key Midtrans dari Midtrans Dashboard -> Settings -> Access Keys (server-side only)
MIDTRANS_SERVER_KEY=