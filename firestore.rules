rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function hasVerifiedEmail() {
      return isSignedIn() &&
             request.auth.token.email is string &&
             request.auth.token.email_verified == true;
    }

    function lowerEmail() {
      return request.auth.token.email.lower();
    }

    function isMemberByData(data) {
      return request.auth.uid in data.memberUids ||
             (hasVerifiedEmail() && lowerEmail() in data.memberEmails);
    }

    function isStoreMemberByLookup(storeId) {
      let storeData = get(/databases/$(database)/documents/stores/$(storeId)).data;
      return request.auth.uid in storeData.memberUids ||
             (hasVerifiedEmail() && lowerEmail() in storeData.memberEmails);
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.email is string && data.email.size() <= 160 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.activeStoreId is string && data.activeStoreId.size() <= 128 &&
             data.role in ['OWNER', 'KASIR'];
    }

    function isValidStore(data) {
      return data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 25 &&
             data.memberUids[0] is string &&
             data.memberEmails is list && data.memberEmails.size() >= 1 && data.memberEmails.size() <= 25 &&
             data.memberEmails[0] is string &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 60 &&
             (!('businessType' in data) || (data.businessType is string && data.businessType.size() <= 60)) &&
             data.logoIconKey in ['STORE', 'CART', 'COFFEE', 'FOOD', 'BAG', 'SPARK'] &&
             (!('logoBase64' in data) || (data.logoBase64 is string && data.logoBase64.size() <= 200000)) &&
             data.themePaletteKey in ['EMERALD', 'SAGE', 'TEAL', 'OCEAN', 'TERRACOTTA'] &&
             data.address is string && data.address.size() <= 240 &&
             data.whatsapp is string && data.whatsapp.size() <= 40 &&
             data.email is string && data.email.size() <= 160 &&
             data.ownerName is string && data.ownerName.size() <= 100 &&
             data.description is string && data.description.size() <= 300 &&
             data.receiptFooter is string && data.receiptFooter.size() <= 240 &&
             data.taxPercent is number && data.taxPercent >= 0 && data.taxPercent <= 100 &&
             data.defaultDiscountPercent is number && data.defaultDiscountPercent >= 0 && data.defaultDiscountPercent <= 100 &&
             data.paymentGatewayProvider == 'MIDTRANS' &&
             data.bankTransferInfo is string && data.bankTransferInfo.size() <= 240;
    }

    function isValidStaffInvite(data) {
      return data.storeId is string && isValidId(data.storeId) &&
             data.storeName is string && data.storeName.size() >= 1 && data.storeName.size() <= 60 &&
             data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.staffEmail is string && data.staffEmail.size() >= 3 && data.staffEmail.size() <= 160 &&
             data.staffName is string && data.staffName.size() >= 1 && data.staffName.size() <= 100 &&
             data.role == 'KASIR' &&
             data.canAccessKasir is bool &&
             data.canManageProducts is bool &&
             data.canManageCategories is bool &&
             data.canViewTransactions is bool &&
             data.canViewReports is bool &&
             data.canManageSettings is bool &&
             data.status in ['PENDING', 'ACCEPTED', 'REVOKED'] &&
             (!('acceptedByUid' in data) || (data.acceptedByUid is string && data.acceptedByUid.size() <= 128));
    }

    function isValidStaffMember(data) {
      return data.staffUid is string && isValidId(data.staffUid) &&
             data.storeId is string && isValidId(data.storeId) &&
             data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.inviteId is string && data.inviteId.size() <= 128 &&
             data.email is string && data.email.size() <= 160 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.role in ['OWNER', 'KASIR'] &&
             data.active is bool &&
             data.canAccessKasir is bool &&
             data.canManageProducts is bool &&
             data.canManageCategories is bool &&
             data.canViewTransactions is bool &&
             data.canViewReports is bool &&
             data.canManageSettings is bool;
    }

    function isValidCategory(data) {
      return data.storeId is string && isValidId(data.storeId) &&
             data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 25 &&
             data.memberUids[0] is string &&
             data.memberEmails is list && data.memberEmails.size() >= 1 && data.memberEmails.size() <= 25 &&
             data.memberEmails[0] is string &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 50 &&
             data.colorHex is string && data.colorHex.size() >= 4 && data.colorHex.size() <= 16;
    }

    function isValidProduct(data) {
      return data.storeId is string && isValidId(data.storeId) &&
             data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 25 &&
             data.memberUids[0] is string &&
             data.memberEmails is list && data.memberEmails.size() >= 1 && data.memberEmails.size() <= 25 &&
             data.memberEmails[0] is string &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
             data.categoryId is string && data.categoryId.size() <= 128 &&
             data.categoryName is string && data.categoryName.size() <= 50 &&
             data.barcode is string && data.barcode.size() <= 64 &&
             data.costPrice is int && data.costPrice >= 0 &&
             data.sellPrice is int && data.sellPrice >= 0 &&
             data.stock is int && data.stock >= 0 &&
             data.unit is string && data.unit.size() >= 1 && data.unit.size() <= 20 &&
             data.minStockAlert is int && data.minStockAlert >= 0 &&
             (!('imageBase64' in data) || (data.imageBase64 is string && data.imageBase64.size() <= 200000));
    }

    function isValidTransaction(data) {
      return data.storeId is string && isValidId(data.storeId) &&
             data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 25 &&
             data.memberUids[0] is string &&
             data.memberEmails is list && data.memberEmails.size() >= 1 && data.memberEmails.size() <= 25 &&
             data.memberEmails[0] is string &&
             data.invoiceNumber is string && data.invoiceNumber.size() >= 1 && data.invoiceNumber.size() <= 64 &&
             data.cashierUid is string && data.cashierUid.size() >= 1 && data.cashierUid.size() <= 128 &&
             data.cashierName is string && data.cashierName.size() >= 1 && data.cashierName.size() <= 100 &&
             data.note is string && data.note.size() <= 240 &&
             data.items is list && data.items.size() >= 1 && data.items.size() <= 100 &&
             data.items[0] is map &&
             data.subtotal is int && data.subtotal >= 0 &&
             data.discountAmount is int && data.discountAmount >= 0 &&
             data.discountType in ['NOMINAL', 'PERCENT'] &&
             data.taxAmount is int && data.taxAmount >= 0 &&
             data.totalAmount is int && data.totalAmount >= 0 &&
             data.totalCost is int && data.totalCost >= 0 &&
             data.totalProfit is int &&
             data.paymentMethod in ['TUNAI', 'QRIS', 'VIRTUAL_ACCOUNT', 'EWALLET', 'TRANSFER'] &&
             data.paymentStatus == 'VERIFIED' &&
             data.gatewayProvider is string && data.gatewayProvider.size() <= 32 &&
             data.gatewayOrderId is string && data.gatewayOrderId.size() <= 128 &&
             data.cashReceived is int && data.cashReceived >= 0 &&
             data.changeAmount is int && data.changeAmount >= 0 &&
             (!('customerId' in data) || (data.customerId is string && data.customerId.size() <= 128)) &&
             (!('customerName' in data) || (data.customerName is string && data.customerName.size() <= 100)) &&
             (!('pointsEarned' in data) || (data.pointsEarned is int && data.pointsEarned >= 0)) &&
             (!('pointsRedeemed' in data) || (data.pointsRedeemed is int && data.pointsRedeemed >= 0));
    }

    function isValidCustomer(data) {
      return data.storeId is string && isValidId(data.storeId) &&
             data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 25 &&
             data.memberUids[0] is string &&
             data.memberEmails is list && data.memberEmails.size() >= 1 && data.memberEmails.size() <= 25 &&
             data.memberEmails[0] is string &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
             data.phone is string && data.phone.size() <= 40 &&
             data.email is string && data.email.size() <= 160 &&
             data.address is string && data.address.size() <= 240 &&
             data.notes is string && data.notes.size() <= 300 &&
             data.loyaltyPoints is int && data.loyaltyPoints >= 0 &&
             data.totalSpent is int && data.totalSpent >= 0 &&
             data.visitCount is int && data.visitCount >= 0 &&
             (!('lastPurchaseAt' in data) || (data.lastPurchaseAt is timestamp && data.lastPurchaseAt <= request.time));
    }

    // 1. User Profiles
    match /users/{userId} {
      allow get, list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'email', 'displayName', 'activeStoreId', 'role', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'email', 'displayName', 'activeStoreId', 'role', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'activeStoreId', 'role', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    // 2. Staff Invites
    match /staffInvites/{inviteId} {
      allow get: if isSignedIn() &&
                    isValidId(inviteId) &&
                    (existing().ownerUid == request.auth.uid ||
                     (hasVerifiedEmail() && existing().staffEmail == lowerEmail()));

      allow list: if isSignedIn() &&
                     (existing().ownerUid == request.auth.uid ||
                      (hasVerifiedEmail() && existing().staffEmail == lowerEmail()));

      allow create: if isSignedIn() &&
                       isValidId(inviteId) &&
                       incoming().ownerUid == request.auth.uid &&
                       incoming().status == 'PENDING' &&
                       incoming().keys().hasAll(['storeId', 'storeName', 'ownerUid', 'staffEmail', 'staffName', 'role', 'canAccessKasir', 'canManageProducts', 'canManageCategories', 'canViewTransactions', 'canViewReports', 'canManageSettings', 'status', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['storeId', 'storeName', 'ownerUid', 'staffEmail', 'staffName', 'role', 'canAccessKasir', 'canManageProducts', 'canManageCategories', 'canViewTransactions', 'canViewReports', 'canManageSettings', 'status', 'acceptedByUid', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidStaffInvite(incoming()) &&
                       exists(/databases/$(database)/documents/stores/$(incoming().storeId)) &&
                       get(/databases/$(database)/documents/stores/$(incoming().storeId)).data.ownerUid == request.auth.uid;

      allow update: if isSignedIn() &&
                       isValidId(inviteId) &&
                       isValidStaffInvite(incoming()) &&
                       incoming().storeId == existing().storeId &&
                       incoming().ownerUid == existing().ownerUid &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       (
                         (existing().ownerUid == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['staffName', 'canAccessKasir', 'canManageProducts', 'canManageCategories', 'canViewTransactions', 'canViewReports', 'canManageSettings', 'status', 'updatedAt']))
                         ||
                         (existing().status == 'PENDING' &&
                          hasVerifiedEmail() &&
                          existing().staffEmail == lowerEmail() &&
                          incoming().status == 'ACCEPTED' &&
                          incoming().acceptedByUid == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'acceptedByUid', 'updatedAt']))
                       );

      allow delete: if isSignedIn() && isValidId(inviteId) && existing().ownerUid == request.auth.uid;
    }

    // 3. Stores and Nested Store Resources
    match /stores/{storeId} {
      allow get: if isSignedIn() && isValidId(storeId) && isMemberByData(existing());
      allow list: if isSignedIn() && isMemberByData(existing());

      allow create: if isSignedIn() &&
                       isValidId(storeId) &&
                       incoming().ownerUid == request.auth.uid &&
                       request.auth.uid in incoming().memberUids &&
                       (!hasVerifiedEmail() || lowerEmail() in incoming().memberEmails) &&
                       incoming().keys().hasAll(['ownerUid', 'memberUids', 'memberEmails', 'name', 'logoIconKey', 'themePaletteKey', 'address', 'whatsapp', 'email', 'ownerName', 'description', 'receiptFooter', 'taxPercent', 'defaultDiscountPercent', 'paymentGatewayProvider', 'bankTransferInfo', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['ownerUid', 'memberUids', 'memberEmails', 'name', 'businessType', 'logoIconKey', 'logoBase64', 'themePaletteKey', 'address', 'whatsapp', 'email', 'ownerName', 'description', 'receiptFooter', 'taxPercent', 'defaultDiscountPercent', 'paymentGatewayProvider', 'bankTransferInfo', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidStore(incoming());

      allow update: if isSignedIn() &&
                       isValidId(storeId) &&
                       isValidStore(incoming()) &&
                       incoming().ownerUid == existing().ownerUid &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       (
                         (existing().ownerUid == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'memberEmails', 'name', 'businessType', 'logoIconKey', 'logoBase64', 'themePaletteKey', 'address', 'whatsapp', 'email', 'ownerName', 'description', 'receiptFooter', 'taxPercent', 'defaultDiscountPercent', 'paymentGatewayProvider', 'bankTransferInfo', 'updatedAt']))
                         ||
                         (hasVerifiedEmail() &&
                          lowerEmail() in existing().memberEmails &&
                          request.auth.uid in incoming().memberUids &&
                          incoming().memberUids.hasAll(existing().memberUids) &&
                          incoming().memberUids.size() <= existing().memberUids.size() + 1 &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt']) &&
                          existsAfter(/databases/$(database)/documents/stores/$(storeId)/staff/$(request.auth.uid)))
                       );

      allow delete: if isSignedIn() && isValidId(storeId) && existing().ownerUid == request.auth.uid;

      // 3a. Store Staff Members
      match /staff/{staffUid} {
        allow get: if isSignedIn() &&
                      isValidId(storeId) &&
                      isValidId(staffUid) &&
                      (request.auth.uid == staffUid || existing().ownerUid == request.auth.uid);

        allow list: if isSignedIn() &&
                       (existing().ownerUid == request.auth.uid || existing().staffUid == request.auth.uid);

        allow create: if isSignedIn() &&
                         isValidId(storeId) &&
                         isValidId(staffUid) &&
                         isValidStaffMember(incoming()) &&
                         incoming().storeId == storeId &&
                         incoming().staffUid == staffUid &&
                         incoming().keys().hasAll(['staffUid', 'storeId', 'ownerUid', 'inviteId', 'email', 'displayName', 'role', 'active', 'canAccessKasir', 'canManageProducts', 'canManageCategories', 'canViewTransactions', 'canViewReports', 'canManageSettings', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['staffUid', 'storeId', 'ownerUid', 'inviteId', 'email', 'displayName', 'role', 'active', 'canAccessKasir', 'canManageProducts', 'canManageCategories', 'canViewTransactions', 'canViewReports', 'canManageSettings', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         (
                           (incoming().ownerUid == request.auth.uid &&
                            exists(/databases/$(database)/documents/stores/$(storeId)) &&
                            get(/databases/$(database)/documents/stores/$(storeId)).data.ownerUid == request.auth.uid)
                           ||
                           (request.auth.uid == staffUid &&
                            incoming().role == 'KASIR' &&
                            hasVerifiedEmail() &&
                            incoming().email == lowerEmail() &&
                            incoming().inviteId.size() >= 1 &&
                            getAfter(/databases/$(database)/documents/staffInvites/$(incoming().inviteId)).data.staffEmail == lowerEmail() &&
                            getAfter(/databases/$(database)/documents/staffInvites/$(incoming().inviteId)).data.storeId == storeId &&
                            getAfter(/databases/$(database)/documents/staffInvites/$(incoming().inviteId)).data.status == 'ACCEPTED' &&
                            getAfter(/databases/$(database)/documents/staffInvites/$(incoming().inviteId)).data.ownerUid == incoming().ownerUid)
                         );

        allow update: if isSignedIn() &&
                         isValidId(storeId) &&
                         isValidId(staffUid) &&
                         isValidStaffMember(incoming()) &&
                         incoming().storeId == existing().storeId &&
                         incoming().staffUid == existing().staffUid &&
                         incoming().ownerUid == existing().ownerUid &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         existing().ownerUid == request.auth.uid &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'active', 'canAccessKasir', 'canManageProducts', 'canManageCategories', 'canViewTransactions', 'canViewReports', 'canManageSettings', 'updatedAt']);

        allow delete: if isSignedIn() &&
                         isValidId(storeId) &&
                         isValidId(staffUid) &&
                         existing().ownerUid == request.auth.uid;
      }

      // 3b. Store Categories
      match /categories/{categoryId} {
        allow get: if isSignedIn() && isValidId(storeId) && isValidId(categoryId) && isMemberByData(existing());
        allow list: if isSignedIn() && isMemberByData(existing());

        allow create: if isSignedIn() &&
                         isValidId(storeId) &&
                         isValidId(categoryId) &&
                         isValidCategory(incoming()) &&
                         incoming().storeId == storeId &&
                         isMemberByData(incoming()) &&
                         isStoreMemberByLookup(storeId) &&
                         incoming().keys().hasAll(['storeId', 'ownerUid', 'memberUids', 'memberEmails', 'name', 'colorHex', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['storeId', 'ownerUid', 'memberUids', 'memberEmails', 'name', 'colorHex', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time;

        allow update: if isSignedIn() &&
                         isValidId(storeId) &&
                         isValidId(categoryId) &&
                         isValidCategory(incoming()) &&
                         incoming().storeId == existing().storeId &&
                         incoming().ownerUid == existing().ownerUid &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isMemberByData(existing()) &&
                         isStoreMemberByLookup(storeId) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'colorHex', 'memberUids', 'memberEmails', 'updatedAt']);

        allow delete: if isSignedIn() &&
                         isValidId(storeId) &&
                         isValidId(categoryId) &&
                         isMemberByData(existing()) &&
                         isStoreMemberByLookup(storeId);
      }

      // 3c. Store Products
      match /products/{productId} {
        allow get: if isSignedIn() && isValidId(storeId) && isValidId(productId) && isMemberByData(existing());
        allow list: if isSignedIn() && isMemberByData(existing());

        allow create: if isSignedIn() &&
                         isValidId(storeId) &&
                         isValidId(productId) &&
                         isValidProduct(incoming()) &&
                         incoming().storeId == storeId &&
                         isMemberByData(incoming()) &&
                         isStoreMemberByLookup(storeId) &&
                         incoming().keys().hasAll(['storeId', 'ownerUid', 'memberUids', 'memberEmails', 'name', 'categoryId', 'categoryName', 'barcode', 'costPrice', 'sellPrice', 'stock', 'unit', 'minStockAlert', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['storeId', 'ownerUid', 'memberUids', 'memberEmails', 'name', 'categoryId', 'categoryName', 'barcode', 'costPrice', 'sellPrice', 'stock', 'unit', 'minStockAlert', 'imageBase64', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time;

        allow update: if isSignedIn() &&
                         isValidId(storeId) &&
                         isValidId(productId) &&
                         isValidProduct(incoming()) &&
                         incoming().storeId == existing().storeId &&
                         incoming().ownerUid == existing().ownerUid &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isMemberByData(existing()) &&
                         isStoreMemberByLookup(storeId) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'categoryId', 'categoryName', 'barcode', 'costPrice', 'sellPrice', 'stock', 'unit', 'minStockAlert', 'imageBase64', 'memberUids', 'memberEmails', 'updatedAt']);

        allow delete: if isSignedIn() &&
                         isValidId(storeId) &&
                         isValidId(productId) &&
                         isMemberByData(existing()) &&
                         isStoreMemberByLookup(storeId);
      }

      // 3d. Store Customers & Loyalty Profiles
      match /customers/{customerId} {
        allow get: if isSignedIn() && isValidId(storeId) && isValidId(customerId) && isMemberByData(existing());
        allow list: if isSignedIn() && isMemberByData(existing());

        allow create: if isSignedIn() &&
                         isValidId(storeId) &&
                         isValidId(customerId) &&
                         isValidCustomer(incoming()) &&
                         incoming().storeId == storeId &&
                         isMemberByData(incoming()) &&
                         isStoreMemberByLookup(storeId) &&
                         incoming().keys().hasAll(['storeId', 'ownerUid', 'memberUids', 'memberEmails', 'name', 'phone', 'email', 'address', 'notes', 'loyaltyPoints', 'totalSpent', 'visitCount', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['storeId', 'ownerUid', 'memberUids', 'memberEmails', 'name', 'phone', 'email', 'address', 'notes', 'loyaltyPoints', 'totalSpent', 'visitCount', 'lastPurchaseAt', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time;

        allow update: if isSignedIn() &&
                         isValidId(storeId) &&
                         isValidId(customerId) &&
                         isValidCustomer(incoming()) &&
                         incoming().storeId == existing().storeId &&
                         incoming().ownerUid == existing().ownerUid &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isMemberByData(existing()) &&
                         isStoreMemberByLookup(storeId) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'email', 'address', 'notes', 'loyaltyPoints', 'totalSpent', 'visitCount', 'lastPurchaseAt', 'memberUids', 'memberEmails', 'updatedAt']);

        allow delete: if isSignedIn() &&
                         isValidId(storeId) &&
                         isValidId(customerId) &&
                         isMemberByData(existing()) &&
                         isStoreMemberByLookup(storeId);
      }

      // 3e. Store Transactions
      match /transactions/{transactionId} {
        allow get: if isSignedIn() && isValidId(storeId) && isValidId(transactionId) && isMemberByData(existing());
        allow list: if isSignedIn() && isMemberByData(existing());

        allow create: if isSignedIn() &&
                         isValidId(storeId) &&
                         isValidId(transactionId) &&
                         isValidTransaction(incoming()) &&
                         incoming().storeId == storeId &&
                         incoming().cashierUid == request.auth.uid &&
                         isMemberByData(incoming()) &&
                         isStoreMemberByLookup(storeId) &&
                         incoming().keys().hasAll(['storeId', 'ownerUid', 'memberUids', 'memberEmails', 'invoiceNumber', 'cashierUid', 'cashierName', 'note', 'items', 'subtotal', 'discountAmount', 'discountType', 'taxAmount', 'totalAmount', 'totalCost', 'totalProfit', 'paymentMethod', 'paymentStatus', 'gatewayProvider', 'gatewayOrderId', 'cashReceived', 'changeAmount', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['storeId', 'ownerUid', 'memberUids', 'memberEmails', 'invoiceNumber', 'cashierUid', 'cashierName', 'note', 'items', 'subtotal', 'discountAmount', 'discountType', 'taxAmount', 'totalAmount', 'totalCost', 'totalProfit', 'paymentMethod', 'paymentStatus', 'gatewayProvider', 'gatewayOrderId', 'cashReceived', 'changeAmount', 'customerId', 'customerName', 'pointsEarned', 'pointsRedeemed', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time;

        allow update: if isSignedIn() &&
                         isValidId(storeId) &&
                         isValidId(transactionId) &&
                         isValidTransaction(incoming()) &&
                         existing().ownerUid == request.auth.uid &&
                         incoming().storeId == existing().storeId &&
                         incoming().ownerUid == existing().ownerUid &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'memberEmails', 'updatedAt']);

        allow delete: if isSignedIn() &&
                         isValidId(storeId) &&
                         isValidId(transactionId) &&
                         existing().ownerUid == request.auth.uid;
      }
    }
  }
}
